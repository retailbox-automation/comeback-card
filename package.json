{
  "name": "first-purchase",
  "version": "0.1.0",
  "private": true,
  "description": "First Purchase: a BCH stamp that can only be spent at one shop.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "compile": "cashc contracts/stamp.cash -f ts -o src/contract/stamp.artifact.ts && cashc contracts/stamp_cov.cash -f ts -o src/contract/stamp_cov.artifact.ts && cashc contracts/card.cash -f ts -o src/contract/card.artifact.ts",
    "test": "vitest run",
    "test:mutation": "node scripts/mutation-test.mjs",
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit"
  },
  "overrides": {
    "@wizardconnect/core": "0.2.10"
  },
  "dependencies": {
    "@bitauth/libauth": "3.1.0-next.8",
    "@electrum-cash/network": "4.4.8",
    "@wizardconnect/core": "0.2.10",
    "@wizardconnect/dapp": "0.2.7",
    "cashc": "0.14.0",
    "cashscript": "0.14.0",
    "qrcode-generator": "2.0.4",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "typescript": "7.0.2",
    "vite": "8.3.7",
    "vitest": "5.1.0"
  }
}
